# ─────────────────────────────────────────────────────────────────────────────
# Healthcare Multi-DB RAG / MCP demo — environment template
# Copy to `.env` and fill in VOYAGE_API_KEY. Everything else works as-is.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# --- Voyage AI embeddings (REQUIRED) -----------------------------------------
# Get a free key at https://www.voyageai.com/  (this is the ONLY external account
# required for the whole demo).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite
EMBEDDING_DIM=512

# --- HuggingFace (OPTIONAL) --------------------------------------------------
# The MT Samples dataset is public and downloads without auth. A token only helps
# avoid rate limits on the download. Leave blank to download anonymously.
HF_TOKEN=

# --- Postgres (relational + pgvector) ----------------------------------------
POSTGRES_DB=healthcare
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpass

# --- MongoDB (clinical notes) ------------------------------------------------
MONGO_INITDB_DATABASE=clinical
MONGO_USER=rag
MONGO_PASSWORD=ragpass

# --- Neo4j (care-team graph) -------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpass

# --- Keycloak (OAuth 2.1 identity provider) ----------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Public URLs the clients (Claude Code Desktop) reach ---------------------
# These are the ONLY networking knobs. Two deployment modes:
#
#  A) Local (default): leave blank. The stack exposes the app on http://localhost:8080
#     and Keycloak on http://localhost:8081. Add http://localhost:8080/mcp to Claude Code.
#
#  B) GitHub Codespaces: forward ports 8080 and 8081 and set BOTH to Public. Leave these
#     two blank here and instead EXPORT them in the terminal before `docker compose up`
#     (the shell expands $CODESPACE_NAME; a .env line would NOT):
#        export PUBLIC_MCP_URL=https://$CODESPACE_NAME-8080.app.github.dev
#        export PUBLIC_KEYCLOAK_URL=https://$CODESPACE_NAME-8081.app.github.dev
#     (Or paste the literal forwarded URLs from the Ports tab into the two vars below.)
#     Add PUBLIC_MCP_URL + "/mcp" to Claude Code Desktop.
#
#  C) Local HTTPS via Traefik (`docker compose --profile edge up`): set
#        PUBLIC_MCP_URL=https://mcp.local
#        PUBLIC_KEYCLOAK_URL=https://keycloak.local
#     and do the /etc/hosts + mkcert steps.
PUBLIC_MCP_URL=
PUBLIC_KEYCLOAK_URL=

# --- Fixed internal values (change only if you know why) ---------------------
# Internal base the MCP server uses to fetch JWKS (no TLS trust needed inside the net).
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# OPA policy decision point.
OPA_URL=http://opa:8181
